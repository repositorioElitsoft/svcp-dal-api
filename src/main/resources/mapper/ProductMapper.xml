<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.elitsoft.servicampo.mapper.ProductMapper">

    <select id="selectProducts" resultType="com.elitsoft.servicampo.domain.entity.Product">
        SELECT * FROM products
        <where>
            <if test="criteria != null">
                <if test="criteria.name != null and criteria.name != ''">
                    AND name LIKE #{criteria.name}
                </if>
                <if test="criteria.category != null and criteria.category != ''">
                    AND category = #{criteria.category}
                </if>
                <if test="criteria.minPrice != null">
                    AND price >= #{criteria.minPrice}
                </if>
                <if test="criteria.maxPrice != null">
                    AND price <= #{criteria.maxPrice}
                </if>
            </if>
        </where>
        <if test="sortField != null and sortField != ''">
            ORDER BY ${sortField} ${sortDirection}
        </if>
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countProducts" resultType="int">
        SELECT COUNT(*) FROM products
        <where>
            <if test="criteria != null">
                <if test="criteria.name != null and criteria.name != ''">
                    AND name LIKE #{criteria.name}
                </if>
                <if test="criteria.category != null and criteria.category != ''">
                    AND category = #{criteria.category}
                </if>
                <if test="criteria.minPrice != null">
                    AND price >= #{criteria.minPrice}
                </if>
                <if test="criteria.maxPrice != null">
                    AND price <= #{criteria.maxPrice}
                </if>
            </if>
        </where>
    </select>

</mapper>