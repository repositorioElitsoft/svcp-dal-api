<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.elitsoft.servicampo.mapper.ServicioMapper">

    <resultMap id="servicioResultMap" type="com.elitsoft.servicampo.domain.entity.Servicio">
        <id property="id" column="svcs_id" />
        <result property="descripcion" column="svcs_dsc" />
        <association property="estado"  resultMap="com.elitsoft.servicampo.mapper.EstadoMapper.estadoResultMap"/>
        <association property="tipoServicio"  resultMap="com.elitsoft.servicampo.mapper.TipoServicioMapper.tipoServicioResultMap"/>
        <collection property="servicioTrabajos" ofType="com.elitsoft.servicampo.domain.entity.ServicioTrabajo">
            <association property="servicio"  javaType="com.elitsoft.servicampo.domain.entity.Servicio">
                <id property="id" column="svcs_id" />
            </association>
            <association property="trabajo"  resultMap="com.elitsoft.servicampo.mapper.TrabajoMapper.trabajoResultMap"/>
        </collection>
    </resultMap>

 
    <resultMap id="servicioAsginacionResultMap" type="com.elitsoft.servicampo.domain.dto.core.ServicioDTO">
        <id property="id" column="svcs_id" />
        <result property="descripcion" column="svcs_dsc" />
        <result property="servicioTrabajos" column="servicioTrabajos" jdbcType="OTHER" javaType="java.util.List" typeHandler="com.elitsoft.servicampo.handler.ServicioTrabajoListTypeHandler"/>
        <association property="estado" javaType="com.elitsoft.servicampo.domain.dto.core.EstadoDTO">
            <id property="id" column="estd_id" />
            <result property="descripcion" column="estd_dsc" />
        </association>
        <association property="tipoServicio" javaType="com.elitsoft.servicampo.domain.dto.core.TipoServicioDTO">
            <id property="id" column="tpsev_id" />
            <result property="descripcionTipoServicio" column="tpsev_dsc" />
        </association>
    </resultMap>

    <!-- Sentencia SQL de Columnas -->
    <sql id="select">
        SELECT svcs.svcs_id   ,   svcs.svcs_dsc ,
               estd.estd_id   ,   estd.estd_dsc ,
               tpsev.tpsev_id ,   tpsev.tpsev_dsc
    </sql>

    <!-- Sentencia SQL para el FROM -->
    <sql id="from">
        FROM ${schema}servicios as svcs
        INNER JOIN ${schema}estados         as estd  ON svcs.estd_id  = estd.estd_id
        INNER JOIN ${schema}tipos_servicios as tpsev ON svcs.tpsev_id = tpsev.tpsev_id
    </sql>

    <!-- Sentencia SQL de Encontrar por Clave -->
    <select id="encontrarPorClave" parameterType="long" resultMap="servicioResultMap">
        <include refid="select"/>
        <include refid="from"/>
        WHERE svcs.svcs_id  = #{id}
    </select>

   <!-- Sentencia SQL de Obtener todos-->
    <select id="obtenerTodos" resultMap="servicioResultMap">
        <include refid="select"/>
        <include refid="from"/>
    </select>

    <!-- Sentencia SQL de Filtrar y paginar -->
    <select id="filtrar" resultMap="servicioResultMap">
        <include refid="select"/>
        <include refid="from"/>
        <where>
            <if test="filtro != null">
                <if test="filtro.id != null">
                    AND svcs.svcs_id = #{filtro.id}
                </if>
                <if test="filtro.descripcion != null and filtro.descripcion != ''">
                    AND LOWER(svcs.svcs_dsc) LIKE '%' || LOWER(#{filtro.descripcion}) || '%'
                </if>
                <if test="filtro.estado != null">
                    AND svcs.estd_id  = #{filtro.estado}
                </if>
                <if test="filtro.tipoServicio != null">
                    AND svcs.tpsev_id  = #{filtro.tipoServicio}
                </if>
            </if>
        </where>
        <if test="campoOrden != null and campoOrden != ''">
            <choose>
                <when test="campoOrden == 'id'">ORDER BY svcs.svcs_id  ${direccionOrden}</when>
                <when test="campoOrden == 'descripcion'">ORDER BY svcs.svcs_dsc ${direccionOrden}</when>
                <when test="campoOrden == 'estado'">ORDER BY svcs.estd_id  ${direccionOrden}</when>
                <when test="campoOrden == 'tipoServicio'">ORDER BY svcs.tpsev_id ${direccionOrden}</when>
                <otherwise>ORDER BY svcs.svcs_id ASC</otherwise>
            </choose>
        </if>
        <if test="limite != null and desplazamiento != null">
            LIMIT #{limite} OFFSET #{desplazamiento}
        </if>
    </select>

    <!-- Sentencia SQL de contar el Filtro para paginacion -->
    <select id="contarFiltrar" resultType="int">
        SELECT COUNT(*)        
        <include refid="from"/>
        <where>
            <if test="filtro != null">
                <if test="filtro.id != null">
                    AND svcs.svcs_id = #{filtro.id}
                </if>
                <if test="filtro.descripcion != null and filtro.descripcion != ''">
                    AND LOWER(svcs.svcs_dsc) LIKE '%' || LOWER(#{filtro.descripcion}) || '%'
                </if>
                <if test="filtro.estado != null">
                    AND svcs.estd_id  = #{filtro.estado}
                </if>
                <if test="filtro.tipoServicio != null">
                    AND svcs.tpsev_id  = #{filtro.tipoServicio}
                </if>
            </if>
        </where>
    </select>

    <!-- Sentencia SQL de Filtrar y paginar Asignaciones (Servicio -> Trabajos) -->
    <select id="filtrarAsginacion" resultMap="servicioAsginacionResultMap">
        WITH servicios_filtrados AS (
            SELECT 
                svcs.svcs_id,
                svcs.svcs_dsc,
                estd.estd_id,
                estd.estd_dsc,
                tpsev.tpsev_id,
                tpsev.tpsev_dsc
            FROM ${schema}servicios svcs
            INNER JOIN ${schema}estados         as estd  ON svcs.estd_id  = estd.estd_id
            INNER JOIN ${schema}tipos_servicios as tpsev ON svcs.tpsev_id = tpsev.tpsev_id
            <where>
                <if test="filtro != null">
                    <if test="filtro.id != null">
                        AND svcs.svcs_id = #{filtro.id}
                    </if>
                    <if test="filtro.descripcion != null and filtro.descripcion != ''">
                        AND LOWER(svcs.svcs_dsc) LIKE '%' || LOWER(#{filtro.descripcion}) || '%'
                    </if>
                    <if test="filtro.estado != null">
                        AND svcs.estd_id = #{filtro.estado}
                    </if>
                    <if test="filtro.descripcionEstado != null and filtro.descripcionEstado != ''">
                        AND LOWER(estd.estd_dsc) LIKE '%' || LOWER(#{filtro.descripcionEstado}) || '%'
                    </if>
                    <if test="filtro.tipoServicio != null">
                        AND svcs.tpsev_id = #{filtro.tipoServicio}
                    </if>
                    <if test="filtro.descripcionTipoServicio != null and filtro.descripcionTipoServicio != ''">
                        AND LOWER(tpsev.tpsev_dsc) LIKE '%' || LOWER(#{filtro.descripcionTipoServicio}) || '%'
                    </if>
                    <if test="filtro.descripcionTrabajo != null and filtro.descripcionTrabajo != ''">
                        AND EXISTS (
                            SELECT 1 FROM ${schema}servicios_trabajos st
                            JOIN ${schema}trabajos t ON st.trbj_id = t.trbj_id
                            WHERE st.svcs_id = svcs.svcs_id
                            AND LOWER(t.trbj_dsc) LIKE '%' || LOWER(#{filtro.descripcionTrabajo}) || '%'
                        )
                    </if>
                </if>
            </where>
            <if test="campoOrden != null and campoOrden != ''">
                <choose>
                    <when test="campoOrden == 'id'">ORDER BY svcs.svcs_id ${direccionOrden}</when>
                    <when test="campoOrden == 'descripcion'">ORDER BY svcs.svcs_dsc ${direccionOrden}</when>
                    <otherwise>ORDER BY svcs.svcs_id ASC</otherwise>
                </choose>
            </if>
            <if test="campoOrden == null or campoOrden == ''">
                ORDER BY svcs.svcs_id ASC
            </if>
            <if test="limite != null and desplazamiento != null">
                LIMIT #{limite} OFFSET #{desplazamiento}
            </if>
        )
        
        SELECT 
            sf.svcs_id,
            sf.svcs_dsc,
            sf.estd_id,
            sf.estd_dsc,
            sf.tpsev_id,
            sf.tpsev_dsc,
            COALESCE(
                jsonb_agg(
                    CASE WHEN t.trbj_id IS NOT NULL THEN
                        jsonb_build_object(
                            'trabajo', jsonb_build_object(
                                'id', t.trbj_id,
                                'descripcionTrabajo', t.trbj_dsc
                            ),
                            'servicio', jsonb_build_object(
                                'id', sf.svcs_id
                            ),
                            'secuencia', st.svtr_secuencia
                        )
                    ELSE NULL
                    END
                ) FILTER (WHERE t.trbj_id IS NOT NULL),
                '[]'
            ) AS servicioTrabajos
        FROM servicios_filtrados sf
        LEFT JOIN ${schema}servicios_trabajos st ON sf.svcs_id = st.svcs_id
        LEFT JOIN ${schema}trabajos t ON st.trbj_id = t.trbj_id
        <if test="filtro != null and filtro.descripcionTrabajo != null and filtro.descripcionTrabajo != ''">
            AND LOWER(t.trbj_dsc) LIKE '%' || LOWER(#{filtro.descripcionTrabajo}) || '%'
        </if>
        GROUP BY sf.svcs_id, sf.svcs_dsc, sf.estd_id, sf.estd_dsc, sf.tpsev_id, sf.tpsev_dsc
        ORDER BY 
        <if test="campoOrden != null and campoOrden != ''">
            <choose>
                <when test="campoOrden == 'id'">sf.svcs_id ${direccionOrden}</when>
                <when test="campoOrden == 'descripcion'">sf.svcs_dsc ${direccionOrden}</when>
                <when test="campoOrden == 'descripcionEstado'">sf.estd_dsc ${direccionOrden}</when>
                <when test="campoOrden == 'descripcionTipoServicio'">sf.tpsev_dsc ${direccionOrden}</when>
                <otherwise>sf.svcs_id ASC</otherwise>
            </choose>
        </if>
    </select>

    <!-- Sentencia SQL de contar el Filtro para paginacion Asignaciones (Servicio -> Trabajos) -->
    <select id="contarFiltrarAsginacion" resultType="int">
        SELECT COUNT(DISTINCT svcs.svcs_id)        
        FROM ${schema}servicios svcs
        <where>
            <if test="filtro != null">
                <if test="filtro.id != null">
                    AND svcs.svcs_id = #{filtro.id}
                </if>
                <if test="filtro.descripcion != null and filtro.descripcion != ''">
                    AND LOWER(svcs.svcs_dsc) LIKE '%' || LOWER(#{filtro.descripcion}) || '%'
                </if>
                <if test="filtro.estado != null">
                    AND svcs.estd_id = #{filtro.estado}
                </if>
                <if test="filtro.descripcionEstado != null and filtro.descripcionEstado != ''">
                    AND LOWER(estd.estd_dsc) LIKE '%' || LOWER(#{filtro.descripcionEstado}) || '%'
                </if>
                <if test="filtro.tipoServicio != null">
                    AND svcs.tpsev_id = #{filtro.tipoServicio}
                </if>
                <if test="filtro.descripcionTipoServicio != null and filtro.descripcionTipoServicio != ''">
                    AND LOWER(tpsev.tpsev_dsc) LIKE '%' || LOWER(#{filtro.descripcionTipoServicio}) || '%'
                </if>
                <if test="filtro.descripcionTrabajo != null and filtro.descripcionTrabajo != ''">
                    AND EXISTS (
                        SELECT 1 FROM ${schema}servicios_trabajos st
                        JOIN ${schema}trabajos t ON st.trbj_id = t.trbj_id
                        WHERE st.svcs_id = svcs.svcs_id
                        AND LOWER(t.trbj_dsc) LIKE '%' || LOWER(#{filtro.descripcionTrabajo}) || '%'
                    )
                </if>
            </if>
        </where>
    </select>

    <!-- Sentencia SQL de Insertar con campo Auto Incrementado-->
    <select id="agregar" resultType="com.elitsoft.servicampo.domain.entity.Servicio" affectData="true" flushCache="true">
        INSERT INTO ${schema}servicios (svcs_dsc, estd_id, tpsev_id )
        VALUES (#{descripcion}, #{estado.id}, #{tipoServicio.id})
        returning svcs_id as id, svcs_dsc as descripcion, estd_id as estadoId
    </select>


    <!-- Sentencia SQL de Actualizar-->
    <update id="actualizar" parameterType="com.elitsoft.servicampo.domain.entity.Servicio">
        UPDATE ${schema}servicios
        SET svcs_dsc = #{descripcion} , estd_id = #{estado.id} , tpsev_id = #{tipoServicio.id}
        WHERE svcs_id = #{id}
    </update>

    <!-- Sentencia SQL de Eliminar-->
    <delete id="eliminar" parameterType="long">
        DELETE FROM ${schema}servicios
        WHERE svcs_id = #{id}
    </delete>

    <!-- Sentencia SQL de Insertar LOTE-->
    <insert id="agregarLote" parameterType="java.util.List" >
        INSERT INTO ${schema}servicios (svcs_dsc, estd_id, tpsev_id ) VALUES
        <foreach item="servicio" collection="servicioLote" separator=",">
            (#{servicio.descripcion}, #{servicio.estado.id}, #{servicio.tipoServicio.id})
        </foreach>
    </insert>

    <!-- Sentencia SQL de Actualizar LOTE-->
    <update id="actualizarLote" parameterType="java.util.List" >
        <foreach item='servicio' collection='servicioLote' separator=';'>
            UPDATE ${schema}servicios
            SET svcs_dsc  = #{servicio.descripcion},
                estd_id   = #{servicio.estado.id} ,
                tpsev_id  = #{servicio.tipoServicio.id}
            WHERE svcs_id = #{servicio.id}
        </foreach>
    </update>

    <!-- Sentencia SQL de Eliminar LOTE-->
    <delete id="eliminarLote" parameterType="java.util.List" >
        DELETE FROM ${schema}servicios WHERE svcs_id IN
        <foreach item='servicio' collection='servicioLote' open='(' separator=',' close=')'>
            #{servicio.id}
        </foreach>
    </delete>
</mapper>