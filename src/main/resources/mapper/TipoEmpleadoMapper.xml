<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.elitsoft.servicampo.mapper.TipoEmpleadoMapper">

    <resultMap id="tipoEmpleadoResultMap" type="com.elitsoft.servicampo.domain.entity.TipoEmpleado">
        <id property="id" column="tpem_id"/>
        <result property="descripcionTipoEmpleado" column="tpem_dsc"/>
    </resultMap>

    <!-- Sentencia SQL de Encontrar por Clave -->
    <select id="encontrarPorClave" parameterType="long" resultMap="tipoEmpleadoResultMap">
        SELECT tpem_id, tpem_dsc FROM ${schema}tipos_empleados WHERE tpem_id = #{id}
    </select>

   <!-- Sentencia SQL de Obtener todos-->
    <select id="obtenerTodos" resultMap="tipoEmpleadoResultMap">
        SELECT tpem_id, tpem_dsc FROM ${schema}tipos_empleados
    </select>

    <!-- Sentencia SQL de Filtrar y paginar -->
    <select id="filtrar" resultMap="tipoEmpleadoResultMap">
        SELECT * FROM ${schema}tipos_empleados
        <where>
            <if test="filtro != null">
                <if test="filtro.id != null">
                    AND tpem_id = #{filtro.id}
                </if>
                <if test="filtro.descripcionTipoEmpleado != null and filtro.descripcionTipoEmpleado != ''">
                    AND LOWER(tpem_dsc) LIKE '%' || LOWER(#{filtro.descripcionTipoEmpleado}) || '%'
                </if>
            </if>
        </where>
        <if test="campoOrden != null and campoOrden != ''">
            <choose>
                <when test="campoOrden == 'id'">ORDER BY tpem_id ${direccionOrden}</when>
                <when test="campoOrden == 'descripcionTipoEmpleado'">ORDER BY tpem_dsc ${direccionOrden}</when>
                <otherwise>ORDER BY tpem_id ASC</otherwise>
            </choose>
        </if>
        <if test="limite != null and desplazamiento != null">
            LIMIT #{limite} OFFSET #{desplazamiento}
        </if>
    </select>

    <!-- Sentencia SQL de contar el Filtro para paginacion -->
    <select id="contarFiltrar" resultType="int">
        SELECT COUNT(*) FROM ${schema}tipos_empleados
        <where>
            <if test="filtro != null">
                <if test="filtro.id != null">
                    AND tpem_id = #{filtro.id}
                </if>
                <if test="filtro.descripcionTipoEmpleado != null and filtro.descripcionTipoEmpleado != ''">
                    AND LOWER(tpem_dsc) LIKE '%' || LOWER(#{filtro.descripcionTipoEmpleado}) || '%'
                </if>
            </if>
        </where>
    </select>

    <!-- Sentencia SQL de Insertar con campo Auto Incrementado-->
      <select id="agregar" resultType="com.elitsoft.servicampo.domain.entity.TipoEmpleado" affectData="true" flushCache="true">
        INSERT INTO ${schema}tipos_empleados (tpem_dsc)
        VALUES (#{descripcionTipoEmpleado})
        returning tpem_id as id, tpem_dsc as descripcionTipoEmpleado
    </select>

    <!-- Sentencia SQL de Actualizar-->
    <update id="actualizar" parameterType="com.elitsoft.servicampo.domain.entity.TipoEmpleado">
        UPDATE ${schema}tipos_empleados SET tpem_dsc = #{descripcionTipoEmpleado} WHERE tpem_id = #{id}
    </update>

    <!-- Sentencia SQL de Eliminar-->
    <delete id="eliminar" parameterType="long">
        DELETE FROM ${schema}tipos_empleados WHERE tpem_id = #{id}
    </delete>

    <!-- Sentencia SQL de Insertar LOTE-->
    <insert id="agregarLote" parameterType="java.util.List" >
        INSERT INTO ${schema}tipos_empleados (tpem_dsc) VALUES
        <foreach item="tipoEmpleado" collection="tipoEmpleadoLote" separator=",">
            (#{tipoEmpleado.descripcionTipoEmpleado})
        </foreach>
    </insert>

    <!-- Sentencia SQL de Actualizar LOTE-->
    <update id="actualizarLote" parameterType="java.util.List" >
        <foreach item='tipoEmpleado' collection='tipoEmpleadoLote' separator=';'>
            UPDATE ${schema}tipos_empleados
            SET tpem_dsc = #{tipoEmpleado.descripcionTipoEmpleado}
            WHERE tpem_id = #{tipoEmpleado.id}
        </foreach>
    </update>

    <!-- Sentencia SQL de Eliminar LOTE-->
    <delete id="eliminarLote" parameterType="java.util.List" >
        DELETE FROM ${schema}tipos_empleados WHERE tpem_id IN
        <foreach item='id' collection='idLote' open='(' separator=',' close=')'>
            #{id}
        </foreach>
    </delete>
</mapper>