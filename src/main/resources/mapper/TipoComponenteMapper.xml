<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.elitsoft.servicampo.mapper.TipoComponenteMapper">

    <resultMap id="tipoComponenteResultMap" type="com.elitsoft.servicampo.domain.entity.TipoComponente">
        <id property="id" column="tpcm_id" />
        <result property="nombre" column="tpcm_nombre" />
        <result property="descripcion" column="tpcm_dsc" />
    </resultMap>

    <!-- Sentencia SQL de Columnas -->
    <sql id="select">
        SELECT tpcm_id, tpcm_nombre, tpcm_dsc
    </sql>

    <!-- Sentencia SQL para el FROM -->
    <sql id="from">
        FROM ${schema}tipos_componentes
    </sql>

    <!-- Sentencia SQL de Encontrar por Clave -->
    <select id="encontrarPorClave" parameterType="long" resultMap="tipoComponenteResultMap">
        <include refid="select"/>
        <include refid="from"/>
        WHERE tpcm_id = #{id}
    </select>

   <!-- Sentencia SQL de Obtener todos-->
    <select id="obtenerTodos" resultMap="tipoComponenteResultMap">
        <include refid="select"/>
        <include refid="from"/>
    </select>

    <!-- Sentencia SQL de Filtrar y paginar -->
    <select id="filtrar" resultMap="tipoComponenteResultMap">
        <include refid="select"/>
        <include refid="from"/>
        <where>
            <if test="filtro != null">
                <if test="filtro.id != null">
                    AND tpcm_id = #{filtro.id}
                </if>
                <if test="filtro.nombre != null and filtro.nombre != ''">
                    AND LOWER(tpcm_nombre) LIKE '%' || LOWER(#{filtro.nombre}) || '%'
                </if>
            </if>
        </where>
        <if test="campoOrden != null and campoOrden != ''">
            <choose>
                <when test="campoOrden == 'id'">ORDER BY tpcm_id ${direccionOrden}</when>
                <when test="campoOrden == 'nombre'">ORDER BY tpcm_nombre ${direccionOrden}</when>
                <when test="campoOrden == 'descripcion'">ORDER BY tpcm_dsc ${direccionOrden}</when>
                <otherwise>ORDER BY tpcm_id ASC</otherwise>
            </choose>
        </if>
        <if test="limite != null and desplazamiento != null">
            LIMIT #{limite} OFFSET #{desplazamiento}
        </if>
    </select>

    <!-- Sentencia SQL de contar el Filtro para paginacion -->
    <select id="contarFiltrar" resultType="int">
        SELECT COUNT(*)        
        <include refid="from"/>
        <where>
            <if test="filtro != null">
                <if test="filtro.id != null">
                    AND tpcm_id = #{filtro.id}
                </if>
                <if test="filtro.nombre != null and filtro.nombre != ''">
                    AND LOWER(tpcm_nombre) LIKE '%' || LOWER(#{filtro.nombre}) || '%'
                </if>
            </if>
        </where>
    </select>

    <!-- Sentencia SQL de Insertar con campo Auto Incrementado-->
      <select id="agregar" resultType="com.elitsoft.servicampo.domain.entity.TipoComponente" affectData="true" flushCache="true">
        INSERT INTO ${schema}tipos_componentes (tpcm_nombre, tpcm_dsc)
        VALUES (#{nombre}, #{descripcion})
        returning tpcm_id as id, tpcm_nombre as nombre, tpcm_dsc as descripcion
    </select>

    <!-- Sentencia SQL de Actualizar-->
    <update id="actualizar" parameterType="com.elitsoft.servicampo.domain.entity.TipoComponente">
        UPDATE ${schema}tipos_componentes
        SET  tpcm_nombre = #{nombre}      ,
             tpcm_dsc    = #{descripcion}
        WHERE tpcm_id = #{id}
    </update>

    <!-- Sentencia SQL de Eliminar-->
    <delete id="eliminar" parameterType="long">
        DELETE FROM ${schema}tipos_componentes
        WHERE tpcm_id = #{id}
    </delete>

    <!-- Sentencia SQL de Insertar LOTE-->
    <insert id="agregarLote" parameterType="java.util.List" >
        INSERT INTO ${schema}tipos_componentes (tpcm_nombre, tpcm_dsc ) VALUES
        <foreach item="tipoComponente" collection="tipoComponenteLote" separator=",">
            (#{tipoComponente.nombre}, #{tipoComponente.descripcion})
        </foreach>
    </insert>

    <!-- Sentencia SQL de Actualizar LOTE-->
    <update id="actualizarLote" parameterType="java.util.List" >
        <foreach item='tipoComponente' collection='tipoComponenteLote' separator=';'>
            UPDATE ${schema}tipos_componentes
            SET tpcm_nombre = #{tipoComponente.nombre}     ,
                tpcm_dsc    = #{tipoComponente.descripcion}
            WHERE tpcm_id = #{tipoComponente.id}
        </foreach>
    </update>

    <!-- Sentencia SQL de Eliminar LOTE-->
    <delete id="eliminarLote" parameterType="java.util.List" >
        DELETE FROM ${schema}tipos_componentes WHERE tpcm_id IN
        <foreach item="tipoComponente" collection="tipoComponenteLote" open='(' separator=',' close=')'>
            #{tipoComponente.id}
        </foreach>
    </delete>
</mapper>