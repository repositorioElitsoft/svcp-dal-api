<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.elitsoft.servicampo.mapper.SectorMapper">

    <resultMap id="sectorResultMap" type="com.elitsoft.servicampo.domain.entity.Sector">
        <id property="id" column="sctr_id" />
        <result property="descripcionSector" column="sctr_dsc" />
        <association property="zona"  resultMap="com.elitsoft.servicampo.mapper.ZonaMapper.zonaResultMap"/>
    </resultMap>

    <!-- Sentencia SQL de Columnas -->
    <sql id="select">
        SELECT sctr.sctr_id, sctr.sctr_dsc,
               znas.znas_id, znas.znas_dsc
    </sql>

    <!-- Sentencia SQL para el FROM -->
    <sql id="from">
        FROM ${schema}sectores sctr
        INNER JOIN ${schema}zonas znas ON sctr.znas_id = znas.znas_id
    </sql>

    <!-- Sentencia SQL de Encontrar por Clave -->
    <select id="encontrarPorClave" parameterType="long" resultMap="sectorResultMap">
        <include refid="select"/>
        <include refid="from"/>
        WHERE sctr.sctr_id = #{id}
    </select>

    <!-- Sentencia SQL de Obtener todos-->
    <select id="obtenerTodos" parameterType="long" resultMap="sectorResultMap">
        <include refid="select"/>
        <include refid="from"/>
        WHERE znas.znas_id = #{zonaId}
        order by sctr.sctr_dsc
    </select>

    <!-- Sentencia SQL de Encontrar por Zona -->
    <select id="encontrarPorZona"  resultMap="sectorResultMap">
        <include refid="select"/>
        <include refid="from"/>
        WHERE znas.znas_id = #{zonaId}

        <!-- Para limitar el tamaño del resultado-->
        <if test="limite">
            LIMIT 2 OFFSET 0;
        </if>
    </select>

    <!-- Sentencia SQL de Filtrar y paginar -->
    <select id="filtrar" resultMap="sectorResultMap">
        <include refid="select"/>
        <include refid="from"/>
        <where>
            <if test="filtro != null">
                <if test="filtro.id != null">
                    AND sctr.sctr_id = #{filtro.id}
                </if>
                <if test="filtro.descripcionSector != null and filtro.descripcionSector != ''">
                    AND LOWER(sctr.sctr_dsc) LIKE '%' || LOWER(#{filtro.descripcionSector}) || '%'
                </if>
                <if test="filtro.zonaId != null">
                    AND sctr.znas_id = #{filtro.zonaId}
                </if>
            </if>
        </where>
        <if test="campoOrden != null and campoOrden != ''">
            <choose>
                <when test="campoOrden == 'id'">ORDER BY sctr.sctr_id ${direccionOrden}</when>
                <when test="campoOrden == 'descripcionSector'">ORDER BY sctr.sctr_dsc ${direccionOrden}</when>
                <when test="campoOrden == 'zonaId'">ORDER BY sctr.znas_id ${direccionOrden}</when>
                <otherwise>ORDER BY sctr.sctr_id ASC</otherwise>
            </choose>
        </if>
        <if test="limite != null and desplazamiento != null">
            LIMIT #{limite} OFFSET #{desplazamiento}
        </if>
    </select>

    <!-- Sentencia SQL de contar el Filtro para paginacion -->
    <select id="contarFiltrar" resultType="int">
        SELECT COUNT(*)
        <include refid="from"/>
        <where>
            <if test="filtro != null">
                <if test="filtro.id != null">
                    AND sctr.sctr_id = #{filtro.id}
                </if>
                <if test="filtro.descripcionSector != null and filtro.descripcionSector != ''">
                    AND LOWER(sctr.sctr_dsc) LIKE '%' || LOWER(#{filtro.descripcionSector}) || '%'
                </if>
                <if test="filtro.zonaId != null">
                    AND sctr.znas_id = #{filtro.zonaId}
                </if>
            </if>
        </where>
    </select>


    <!--  Sentencia SQL de Insertar con campo Auto Incrementado -->
   <select id="agregar" resultType="com.elitsoft.servicampo.domain.entity.Sector" affectData="true" flushCache="true">
       INSERT INTO ${schema}sectores (sctr_dsc, znas_id)
       VALUES (#{descripcionSector}, #{zona.id})
       returning sctr_id as id, sctr_dsc as descripcionSector, znas_id as zonaId
   </select>

   <!-- Sentencia SQL de Actualizar-->
    <update id="actualizar" parameterType="com.elitsoft.servicampo.domain.entity.Sector">
        UPDATE ${schema}sectores
        SET sctr_dsc = #{descripcionSector}, znas_id = #{zona.id}
        WHERE sctr_id = #{id}
    </update>

    <!-- Sentencia SQL de Eliminar-->
    <delete id="eliminar" parameterType="long">
        DELETE FROM ${schema}sectores
        WHERE sctr_id = #{id}
    </delete>

    <!-- Sentencia SQL de Insertar LOTE-->
    <insert id="agregarLote" parameterType="java.util.List" >
        INSERT INTO ${schema}sectores (sctr_id, sctr_dsc, znas_id) VALUES
        <foreach item="sector" collection="sectorLote" separator=",">
            (#{sector.id}, #{sector.descripcionSector}, #{sector.zona.id})
        </foreach>
    </insert>

    <!-- Sentencia SQL de Actualizar LOTE-->
    <update id="actualizarLote" parameterType="java.util.List" >
        <foreach item='sector' collection='sectorLote' separator=';'>
            UPDATE ${schema}sectores
            SET sctr_dsc = #{sector.descripcionSector}, znas_id = #{sector.zona.id}
            WHERE sctr_id = #{sector.id}
        </foreach>
    </update>

    <!-- Sentencia SQL de Eliminar LOTE-->
    <delete id="eliminarLote" parameterType="java.util.List" >
        DELETE FROM ${schema}sectores WHERE sctr_id IN
        <foreach item='id' collection='idLote' open='(' separator=',' close=')'>
            #{id}
        </foreach>
    </delete>
</mapper>