<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.elitsoft.servicampo.mapper.EstadoMapper">

    <resultMap id="estadoResultMap" type="com.elitsoft.servicampo.domain.entity.Estado">
        <id property="id" column="estd_id"/>
        <result property="descripcionEstado" column="estd_dsc"/>
    </resultMap>

    <select id="encontrarPorClave" parameterType="long" resultMap="estadoResultMap">
        SELECT estd_id, estd_dsc FROM estados WHERE estd_id = #{id}
    </select>

    <select id="obtenerTodos" resultMap="estadoResultMap">
        SELECT estd_id, estd_dsc FROM estados
    </select>

    <!-- Sentencia SQL de Insertar-->
    <insert id="agregar" parameterType="com.elitsoft.servicampo.domain.entity.Estado" useGeneratedKeys="true" keyProperty="id" keyColumn="estd_id">
        INSERT INTO estados (estd_dsc) VALUES (#{descripcionEstado})
    </insert>

    <!-- Sentencia SQL de Actualizar-->
    <update id="actualizar" parameterType="com.elitsoft.servicampo.domain.entity.Estado">
        UPDATE estados SET estd_dsc = #{descripcionEstado} WHERE estd_id = #{id}
    </update>

    <!-- Sentencia SQL de Eliminar-->
    <delete id="eliminar" parameterType="long">
        DELETE FROM estados WHERE estd_id = #{id}
    </delete>

</mapper>