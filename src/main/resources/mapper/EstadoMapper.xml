<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.elitsoft.servicampo.mapper.EstadoMapper">

    <resultMap id="estadoResultMap" type="com.elitsoft.servicampo.domain.entity.Estado">
        <id property="id" column="estd_id" />
        <result property="descripcion" column="estd_dsc" />
    </resultMap>

    <!-- Sentencia SQL de Columnas -->
    <sql id="estadoColumnas">
        SELECT estd_id, estd_dsc
    </sql>

    <!-- Sentencia SQL para el FROM -->
    <sql id="selectFrom">
        FROM ${schema}estados
    </sql>

    <!-- Sentencia SQL de Encontrar por Clave -->
    <select id="encontrarPorClave" parameterType="long" resultMap="estadoResultMap">
        <include refid="estadoColumnas"/>
        <include refid="selectFrom"/>
        WHERE estd_id = #{id}
    </select>

   <!-- Sentencia SQL de Obtener todos-->
    <select id="obtenerTodos" resultMap="estadoResultMap">
        <include refid="estadoColumnas"/>
        <include refid="selectFrom"/>
    </select>

    <!-- Sentencia SQL de Filtrar y paginar -->
    <select id="filtrar" resultMap="estadoResultMap">
        <include refid="estadoColumnas"/>
        <include refid="selectFrom"/>
        <where>
            <if test="filtro != null">
                <if test="filtro.id != null">
                    AND estd_id = #{filtro.id}
                </if>
                <if test="filtro.descripcion != null and filtro.descripcion != ''">
                    AND LOWER(estd_dsc) LIKE '%' || LOWER(#{filtro.descripcion}) || '%'
                </if>
            </if>
        </where>
        <if test="campoOrden != null and campoOrden != ''">
            <choose>
                <when test="campoOrden == 'id'">ORDER BY estd_id ${direccionOrden}</when>
                <when test="campoOrden == 'descripcion'">ORDER BY estd_dsc ${direccionOrden}</when>
                <otherwise>ORDER BY estd_id ASC</otherwise>
            </choose>
        </if>
        <if test="limite != null and desplazamiento != null">
            LIMIT #{limite} OFFSET #{desplazamiento}
        </if>
    </select>

    <!-- Sentencia SQL de contar el Filtro para paginacion -->
    <select id="contarFiltrar" resultType="int">
        SELECT COUNT(*)        
        <include refid="selectFrom"/>
        <where>
            <if test="filtro != null">
                <if test="filtro.id != null">
                    AND estd_id = #{filtro.id}
                </if>
                <if test="filtro.descripcion != null and filtro.descripcion != ''">
                    AND LOWER(estd_dsc) LIKE '%' || LOWER(#{filtro.descripcion}) || '%'
                </if>
            </if>
        </where>
    </select>


    <!-- Sentencia SQL de Insertar con campo Auto Incrementado-->
      <select id="agregar" resultType="com.elitsoft.servicampo.domain.entity.Estado" affectData="true" flushCache="true">
        INSERT INTO ${schema}estados (estd_id, estd_dsc)
        VALUES (#{id}, #{descripcion})
        returning estd_id as id, estd_dsc as descripcion
    </select>

    <!-- Sentencia SQL de Actualizar-->
    <update id="actualizar" parameterType="com.elitsoft.servicampo.domain.entity.Estado">
        UPDATE ${schema}estados
        SET  estd_dsc = #{descripcion}
        WHERE estd_id = #{id}
    </update>

    <!-- Sentencia SQL de Eliminar-->
    <delete id="eliminar" parameterType="long">
        DELETE FROM ${schema}estados
        WHERE estd_id = #{id}
    </delete>

    <!-- Sentencia SQL de Insertar LOTE-->
    <insert id="agregarLote" parameterType="java.util.List" >
        INSERT INTO ${schema}estados (estd_id, estd_dsc) VALUES
        <foreach item="estado" collection="estadoLote" separator=",">
            (#{estado.id}, #{estado.descripcion} )
        </foreach>
    </insert>

    <!-- Sentencia SQL de Actualizar LOTE-->
    <update id="actualizarLote" parameterType="java.util.List" >
        <foreach item='estado' collection='estadoLote' separator=';'>
            UPDATE ${schema}estados
            SET estd_dsc = #{estado.descripcion}
            WHERE estd_id = #{estado.id}
        </foreach>
    </update>

    <!-- Sentencia SQL de Eliminar LOTE-->
    <delete id="eliminarLote" parameterType="java.util.List" >
        DELETE FROM ${schema}estados WHERE estd_id IN
        <foreach item='id' collection='idLote' open='(' separator=',' close=')'>
            #{id}
        </foreach>
    </delete>
</mapper>